PORT=5000
MONGODB_URI=mongodb+srv://<db_username>:<url_encoded_password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
MONGODB_DNS_SERVERS=
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Preferred on hosts without secret files: paste the service account JSON here.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Or provide the same JSON base64-encoded:
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiw... 
CLIENT_ORIGIN=http://localhost:3000
